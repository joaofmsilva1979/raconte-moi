{
  "expo": {
    "name": "Les notes de patate",
    "slug": "les-notes-de-patate",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "scheme": "lesnotesdepatate",
    "platforms": ["ios"],
    "ios": {
      "bundleIdentifier": "app.notespatate",
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleDisplayName": "Les notes de patate",
        "CFBundleName": "Les notes de patate",
        "NSSpeechRecognitionUsageDescription": "Les notes de patate utilise la reconnaissance vocale pour transcrire ce que tu as mangé."
      }
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#E85520"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Les notes de patate a besoin de ton micro pour enregistrer ce que tu as mangé."
        }
      ],
      "@react-native-voice/voice",
      ["./plugins/withAppleIntelligence"]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
