{
  "expo": {
    "name": "Raconte-moi",
    "slug": "raconte-moi",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "scheme": "racontemoi",
    "platforms": ["ios", "web"],
    "ios": {
      "bundleIdentifier": "app.racontemoi",
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleDisplayName": "Raconte-moi",
        "CFBundleName": "Raconte-moi",
        "NSSpeechRecognitionUsageDescription": "Raconte-moi utilise la reconnaissance vocale pour transcrire ce que tu dis."
      }
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Raconte-moi accède à ta galerie pour joindre une photo à ta note.",
          "cameraPermission": "Raconte-moi utilise la caméra pour prendre une photo de ton repas."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#E85520"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Raconte-moi a besoin de ton micro pour enregistrer ce que tu dis."
        }
      ],
      "@react-native-voice/voice",
      ["./plugins/withAppleIntelligence"]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "privacyPolicyUrl": "https://joaofmsilva1979.github.io/raconte-moi/privacy-policy.html"
    }
  }
}
