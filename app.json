{
  "expo": {
    "name": "Les notes de patate",
    "slug": "les-notes-de-patate",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "lesnotesdepatate",
    "platforms": ["ios"],
    "ios": {
      "bundleIdentifier": "lu.ciglesch.lesnotesdepatate",
      "supportsTablet": false
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#E85520"
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Les notes de patate a besoin de ton micro pour enregistrer ce que tu as mangé."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
